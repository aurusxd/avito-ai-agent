DEEPSEEK_API_KEY=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_CHAT_ID=
DATABASE_URL=sqlite+aiosqlite:///./data/avito.db
DELAY_MIN_MINUTES=5
DELAY_MAX_MINUTES=15
DAILY_MESSAGE_LIMIT=15

AVITO_CLIENT=fake
AVITO_BASE_URL=https://www.avito.ru
AVITO_STORAGE_STATE_PATH=state.json
AVITO_HEADLESS=false
AVITO_PROXY_SERVER=
PARSER_MAX_PAGES=1
PARSER_MAX_SELLERS_PER_RUN=0
PARSER_DELAY_MIN_SECONDS=2.0
PARSER_DELAY_MAX_SECONDS=5.0
PARSER_NAV_TIMEOUT_MS=60000
PARSER_NAV_RETRIES=2
PARSER_RETRY_BACKOFF_SECONDS=3.0
PARSER_PROFILE_SETTLE_MS=1500
PANEL_API_TOKEN=dev-panel-token
OUTREACH_TYPE_DELAY_MIN_MS=40
OUTREACH_TYPE_DELAY_MAX_MS=140
OUTREACH_SETTLE_MS=2500
AVITO_BLOCK_CHECK_DELAY_MS=1500

AI_CLIENT=fake
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=1.5
AI_TEMPERATURE=1.0
AI_MAX_TOKENS=300
AI_MAX_VARIATION_LENGTH=500
AI_SENTIMENT_THRESHOLD=0.6

TELEGRAM_CLIENT=fake
TELEGRAM_TIMEOUT_SECONDS=15.0
LEADS_POLL_SECONDS=60
LEADS_HISTORY_LIMIT=20

AUTH_CLIENT=fake
LOGIN_WAIT_MS=30000
LOGIN_SETTLE_MS=6000
LOGIN_SESSION_TTL_SECONDS=600
SESSIONS_DIR=data/sessions

# Remote browser view for finishing a captcha by hand.
# Off by default: the display holds a signed-in avito session, so anyone who
# reaches this port can drive that account. Keep the published port on
# 127.0.0.1 and reach it over an ssh tunnel.
VNC_ENABLED=false
VNC_PASSWORD=
VNC_PORT=6080
VNC_PUBLIC_URL=http://localhost:6080/vnc.html
